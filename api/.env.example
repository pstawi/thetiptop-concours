# Copier vers api/.env puis ajuster les valeurs locales
APP_ENV=dev
APP_SECRET=change_me_generate_a_random_secret
DEFAULT_URI=http://127.0.0.1:8000

# CORS — origine du front Vite en local
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# PostgreSQL (docker/docker-compose.yml)
DATABASE_URL="postgresql://thetiptop:thetiptop@127.0.0.1:5432/thetiptop?serverVersion=16&charset=utf8"

# Mailpit SMTP local
MAILER_DSN=smtp://127.0.0.1:1025

# OAuth (étape 4) — laisser vides + mock en local
OAUTH_MOCK=1
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=

# JWT (étape 3)
JWT_SECRET=change_me_jwt_secret

# Concours
APP_CONTEST_DEFAULT_STATUS=PREVIEW

# Analytics (étape 8)
GA4_MEASUREMENT_ID=

# Copier vers api/.env puis ajuster les valeurs locales
APP_ENV=dev
APP_SECRET=change_me_generate_a_random_secret
DEFAULT_URI=http://127.0.0.1:8000

# CORS — origine du front Vite en local
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# PostgreSQL (docker/docker-compose.yml)
DATABASE_URL="postgresql://thetiptop:thetiptop@127.0.0.1:5432/thetiptop?serverVersion=18&charset=utf8"

# Mailpit SMTP local
MAILER_DSN=smtp://127.0.0.1:1025

# Front (redirection callback OAuth)
FRONT_URL=http://127.0.0.1:5173

# OAuth (étape 4) — laisser vides + mock en local
# OAUTH_MOCK=1 → POST /api/v1/auth/oauth/mock autorisé
# Avec clés Google/Facebook → GET /api/v1/auth/oauth/{provider} redirige vers le fournisseur
OAUTH_MOCK=1
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=

# JWT (étape 3) — générer les clés :
# openssl genpkey -out config/jwt/private.pem -aes256 -algorithm rsa -pkeyopt rsa_keygen_bits:4096
# openssl pkey -in config/jwt/private.pem -out config/jwt/public.pem -pubout
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_jwt_passphrase

# Concours
APP_CONTEST_DEFAULT_STATUS=PREVIEW

# Analytics (étape 8)
GA4_MEASUREMENT_ID=
